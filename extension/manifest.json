{
  "manifest_version": 3,
  "name": "Bookmarks Dynamic Manager",
  "version": "1.0.0",
  "description": "Lokale Lesezeichen-Sammlung mit automatischer Multi-Kategorisierung, dynamischen Sammlungen und Suche. Daten bleiben im Browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmarks Dynamic Manager"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "contextMenus", "activeTab", "tabs"],
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Aktuelle Seite zu Bookmarks Dynamic Manager hinzufügen"
    }
  }
}
