{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bookmarks Dynamic Manager",
  "mainBinaryName": "BookmarksDynamicManager",
  "version": "1.4.0",
  "identifier": "io.github.johi251.bookmarks-dynamic-manager",
  "build": {
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Bookmarks Dynamic Manager",
        "url": "index.html?desktop=1.4.0",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https: http://127.0.0.1:* http://localhost:*; worker-src 'self' blob:; media-src 'self' blob: data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
